#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main() {
    double x1, y1, x2, y2;

    cout << "Enter x1: ";
    cin >> x1;
    cout << "\nx1: "<<x1;

    cout << "Enter y1: ";
    cin >> y1;
    cout << "\ny1: "<<y1;

    cout << "Enter x2: ";
    cin >> x2;
    cout << "\nx2: "<<x2;

    cout << "Enter y2: ";
    cin >> y2;
    cout << "\ny2: "<<y2;


    double dx = x2 - x1;
    double dy = y2 - y1;

    double distance = sqrt(pow(dx, 2) + pow(dy, 2));
    int roundedDistance = static_cast<int>(round(distance));

    cout << fixed << setprecision(3);

    cout << "dx = " << dx
         << "; dy = " << dy
         << "; Distance = " << distance
         << "; Rounded distance = " << roundedDistance << endl;

    return 0;
}
